{
    "name": "@codama/renderers-demo",
    "version": "2.0.0-rc.0",
    "description": "Demo renderer to help creating new ones",
    "keywords": [
        "demo",
        "framework",
        "renderers",
        "solana",
        "standard"
    ],
    "bugs": {
        "url": "http://github.com/codama-idl/renderers-demo/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/codama-idl/renderers-demo"
    },
    "files": [
        "./dist/types",
        "./dist/index.*"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/index.node.cjs",
    "module": "./dist/index.node.mjs",
    "browser": {
        "./dist/index.node.cjs": "./dist/index.browser.cjs",
        "./dist/index.node.mjs": "./dist/index.browser.mjs"
    },
    "types": "./dist/types/index.d.ts",
    "react-native": "./dist/index.react-native.mjs",
    "exports": {
        "types": "./dist/types/index.d.ts",
        "react-native": "./dist/index.react-native.mjs",
        "browser": {
            "import": "./dist/index.browser.mjs",
            "require": "./dist/index.browser.cjs"
        },
        "node": {
            "import": "./dist/index.node.mjs",
            "require": "./dist/index.node.cjs"
        }
    },
    "scripts": {
        "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
        "dev": "vitest --project node",
        "format": "oxfmt --check",
        "format:fix": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "release:publish": "pnpm build && changeset publish",
        "release:version": "changeset version && release-tools postversion",
        "test": "pnpm test:types && pnpm test:treeshakability && pnpm test:unit && pnpm test:e2e && pnpm test:exports",
        "test:e2e": "./test/e2e/test.sh",
        "test:exports": "node ./test/exports/module.mjs && node ./test/exports/commonjs.cjs",
        "test:treeshakability": "for file in dist/index.*.mjs; do agadoo $file; done",
        "test:types": "tsc --noEmit",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@codama/errors": "2.0.0-rc.0",
        "@codama/fragments": "2.0.0-rc.0",
        "@codama/nodes": "2.0.0-rc.0",
        "@codama/visitors-core": "2.0.0-rc.0",
        "@solana/codecs": "^8.0.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.0",
        "@changesets/cli": "^3.0.0",
        "@codama/cli": "2.0.0-rc.0",
        "@codama/release-tools": "github:codama-idl/release-tools#v1.3.1",
        "@solana-config/oxc": "^0.1.1",
        "@types/node": "^26",
        "agadoo": "^3.0.0",
        "happy-dom": "^21.0.4",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "rimraf": "6.1.4",
        "tsup": "^9.0.0",
        "typescript": "^5.9.2",
        "vitest": "^5.0.3"
    },
    "browserslist": [
        "supports bigint and not dead",
        "maintained node versions"
    ],
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.18.0",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@10.15.1"
}
